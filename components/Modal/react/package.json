{
  "name": "@cypress-design/react-modal",
  "version": "1.4.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cypress-io/cypress-design.git",
    "directory": "components/Modal/react"
  },
  "files": [
    "*"
  ],
  "typings": "./dist/index.d.ts",
  "module": "./dist/index.es.mjs",
  "main": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.mjs",
      "require": "./dist/index.umd.js"
    }
  },
  "scripts": {
    "build": "yarn build:module && yarn build:types",
    "build:module": "rollup -c ./rollup.config.mjs",
    "build:types": "tsc --project ./tsconfig.types.json && rollup -c ./rollup.dts.config.mjs && rimraf dist/dts"
  },
  "dependencies": {
    "@cypress-design/react-icon": "workspace:^3.4.0",
    "tailwind-merge": "^2.0.0"
  },
  "devDependencies": {
    "@cypress-design/constants-modal": "*",
    "@cypress-design/rollup-plugin-tailwind-keep": "*"
  },
  "license": "MIT"
}
