---
/**
 * DemoTile — one rung of a component's demo ladder.
 *
 * Renders: title → live preview → the tile's source file, verbatim, with
 * Copy and Edit buttons on the code block. Edit swaps the code for an
 * editor and re-renders the preview as you type (lib/tile-editor.ts, loaded
 * on first click); Reset puts the original back.
 * The code block *is* the file (read with ?raw), so what readers copy is
 * exactly what renders above it.
 *
 * Tiles live at docs/src/demos/<component>/<framework>/<name>.{vue,tsx}.
 * When the framework's file doesn't exist yet (React tiles ship in
 * follow-ups), a placeholder points readers to the Vue tab.
 *
 * Props:
 *   component — component directory name, e.g. 'Select'
 *   name      — tile file name without extension, e.g. 'Default'
 *   framework — 'vue' | 'react'
 *   title     — heading shown above the tile (defaults to `name`)
 */
import { Code } from 'astro:components'
import Demo from './Demo.vue'
import DemoReact from './DemoReact'

interface Props {
  component: string
  name: string
  framework: 'vue' | 'react'
  title?: string
}

const { component, name, framework, title = name } = Astro.props

const sources = {
  vue: import.meta.glob('../demos/*/vue/*.vue', { query: '?raw', import: 'default', eager: true }),
  react: import.meta.glob('../demos/*/react/*.tsx', { query: '?raw', import: 'default', eager: true }),
} as Record<'vue' | 'react', Record<string, string>>

const ext = framework === 'vue' ? 'vue' : 'tsx'
const source = sources[framework][`../demos/${component}/${framework}/${name}.${ext}`]
const demoName = `${component}/${framework}/${name}`
---

<section class="demo-tile my-8" data-tile data-framework={framework}>
  <h3>{title}</h3>
  {source ? (
    <>
      <div class="p-6 bg-gray-50 border border-gray-100 rounded-t-lg" data-tile-preview>
        {framework === 'vue' ? (
          <Demo client:only="vue" name={demoName} />
        ) : (
          <DemoReact client:only="react" name={demoName} />
        )}
      </div>
      <div class="relative">
        <Code code={source.trim()} lang={ext} class="!mt-0 !rounded-t-none" />
        <div class="absolute top-3 right-3 flex gap-2">
          <button type="button" data-edit-code class="tile-action">Edit</button>
          <button type="button" data-copy-code class="tile-action">Copy</button>
        </div>
      </div>
    </>
  ) : (
    <div class="p-6 bg-gray-50 border border-gray-100 rounded-lg text-sm text-gray-600">
      React demo coming — see the Vue tab.
    </div>
  )}
</section>

<script>
  // Delegated listeners for every tile's Copy / Edit buttons.
  document.addEventListener('click', async (event) => {
    const target = event.target as Element
    const tile = target.closest<HTMLElement>('[data-tile]')
    const edit = target.closest<HTMLButtonElement>('[data-edit-code]')
    if (tile && edit) {
      const { startEditing, stopEditing } = await import('../lib/tile-editor')
      if (edit.textContent?.trim() === 'Reset') {
        stopEditing(tile)
        edit.textContent = 'Edit'
      } else {
        edit.textContent = 'Reset'
        await startEditing(tile)
      }
      return
    }

    // Copy what's shown: the editor's text while editing, else Shiki's <pre>,
    // whose textContent is the tile file verbatim.
    const button = target.closest<HTMLButtonElement>('[data-copy-code]')
    const code = tile?.querySelector('textarea')?.value ?? tile?.querySelector('pre')?.textContent
    if (!button || code == null) return
    try {
      await navigator.clipboard.writeText(code)
    } catch {
      const textarea = document.createElement('textarea')
      textarea.value = code
      document.body.appendChild(textarea)
      textarea.select()
      document.execCommand('copy')
      textarea.remove()
    }
    button.textContent = 'Copied'
    setTimeout(() => (button.textContent = 'Copy'), 1500)
  })
</script>

<style>
  .tile-action {
    @apply rounded border border-gray-700 bg-gray-900 px-2 py-1 text-xs font-medium text-gray-300 hover:text-white hover:border-gray-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-indigo-400;
  }
</style>
