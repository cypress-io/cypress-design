---
import { CypressMark, CypressLockUp, CypressWatermark } from '@cypress-design/vue-logo'
---

<!-- Mark variants -->
<div class="flex items-center justify-center gap-8 mb-6">
  <div class="p-4">
    <CypressMark client:only="vue" class="size-12 text-gray-500" />
  </div>
  <div class="p-4">
    <CypressMark client:only="vue" class="size-12" variant="color-dark" />
  </div>
  <div class="p-4 rounded bg-gray-1000">
    <CypressMark client:only="vue" class="size-12" variant="color-white" />
  </div>
  <div class="p-4 rounded bg-gray-1000">
    <CypressWatermark client:only="vue" class="size-12" />
  </div>
  <div class="p-4">
    <CypressWatermark client:only="vue" class="size-12" dark />
  </div>
</div>

<!-- LockUp variants -->
<div class="flex items-center justify-center gap-8">
  <div class="p-4">
    <CypressLockUp client:only="vue" class="h-12 w-auto" />
  </div>
  <div class="p-4 rounded bg-gray-1000">
    <CypressLockUp client:only="vue" class="h-12 w-auto" variant="white" />
  </div>
  <div class="p-4">
    <CypressLockUp client:only="vue" class="h-12 w-auto" variant="color-dark" />
  </div>
  <div class="p-4 rounded bg-gray-1000">
    <CypressLockUp client:only="vue" class="h-12 w-auto" variant="color-white" />
  </div>
</div>
