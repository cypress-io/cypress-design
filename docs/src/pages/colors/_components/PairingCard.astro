---
import { cyColors } from '../../../../../css/src/color-constants'

interface Props {
  token1: string
  token2: string
}

const { token1, token2 } = Astro.props
const hexOf = (token: string) => {
  const [hue, step] = token.split('-')
  return (cyColors[hue as keyof typeof cyColors] as Record<string, string>)[step]
}
const bigColor = hexOf(token1)
const smallColor = hexOf(token2)
---

<div class="border border-gray-100 rounded-md overflow-hidden flex flex-col bg-white">
  <div
    class="h-36 grid place-items-center border-b border-gray-100 relative overflow-hidden bg-white"
  >
    <div class="relative w-24 h-24 rounded-md" style={`background:${bigColor}`}>
      <div
        class="absolute left-2 bottom-2 w-8 h-8 rounded"
        style={`background:${smallColor}`}
      ></div>
    </div>
  </div>
  <div class="p-4">
    <div class="flex items-center gap-2 flex-wrap font-brand-mono text-xs text-gray-900">
      <span class="inline-flex items-center gap-2 px-2 py-1 border border-gray-100 rounded-full bg-gray-50">
        <span
          class="w-2 h-2 rounded-sm border border-gray-1000/10 inline-block shrink-0"
          style={`background:${bigColor}`}
        ></span>
        {token1}
      </span>
      <span class="font-brand-heading italic font-normal text-gray-500">with</span>
      <span class="inline-flex items-center gap-2 px-2 py-1 border border-gray-100 rounded-full bg-gray-50">
        <span
          class="w-2 h-2 rounded-sm border border-gray-1000/10 inline-block shrink-0"
          style={`background:${smallColor}`}
        ></span>
        {token2}
      </span>
    </div>
  </div>
</div>
