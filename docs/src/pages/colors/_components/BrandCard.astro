---
import { cyColors } from '../../../../../css/src/color-constants'

interface Props {
  name: string
  token: string
  desc: string
}

const { name, token, desc } = Astro.props
const [hue, step] = token.split('-')
const hex = (cyColors[hue as keyof typeof cyColors] as Record<string, string>)[step]
---

<div class="p-5 rounded border border-gray-100 flex flex-col gap-4 min-h-40 bg-white">
  <div class="w-10 h-10 rounded border border-gray-1000/5" style={`background:${hex}`}></div>
  <div>
    <div class="m-0 mb-1 font-brand-heading text-xl font-semibold text-gray-1000">{name}</div>
    <p class="text-sm m-0 text-gray-700 leading-normal">{desc}</p>
  </div>
  <div class="font-brand-mono text-xs text-gray-600 mt-auto">{token} · {hex}</div>
</div>
