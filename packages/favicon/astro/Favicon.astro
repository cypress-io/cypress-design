---
/**
 * Renders the favicon head tags. Drop it straight into <head>:
 *
 *   ---
 *   import Favicon from '@cypress-design/favicon/astro'
 *   ---
 *   <head>
 *     <Favicon />
 *   </head>
 *
 * For head layers that cannot render a component -- a Docusaurus plugin, an EJS
 * template -- use `FAVICON_LINKS` or `faviconLinksHtml()` from the package root
 * instead. All three are derived from the same array, so they cannot disagree.
 */
import { FAVICON_LINKS, type FaviconLink } from '@cypress-design/favicon'

interface Props {
  /** Override the tag list. Defaults to FAVICON_LINKS. */
  links?: FaviconLink[]
}

const { links = FAVICON_LINKS } = Astro.props
---

{links.map((link) => <link {...link} />)}
